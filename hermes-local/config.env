# Hermes local deployment configuration.
# Every script sources this file. Override any value by exporting it first,
# e.g.  HERMES_PORT=9000 ./scripts/04-install-service.sh

# --- Model -------------------------------------------------------------------
# The Hugging Face repo holding GGUF quants of Hermes 4 14B.
# Verify this repo exists before the first run:  hf download --help ; see README.
HERMES_MODEL_REPO="${HERMES_MODEL_REPO:-NousResearch/Hermes-4-14B-GGUF}"

# Quantisation to pull. Q4_K_M is the recommended 4-bit balance (~9 GB for 14B).
# Alternatives, smallest to largest: Q4_K_S, Q4_K_M, Q5_K_M, Q6_K, Q8_0.
HERMES_QUANT="${HERMES_QUANT:-Q4_K_M}"

# Exact GGUF filename. Leave empty to auto-discover by quant (recommended).
HERMES_MODEL_FILE="${HERMES_MODEL_FILE:-}"

# --- Serving -----------------------------------------------------------------
HERMES_HOST="${HERMES_HOST:-127.0.0.1}"   # 0.0.0.0 exposes it on your LAN
HERMES_PORT="${HERMES_PORT:-8080}"
HERMES_CTX="${HERMES_CTX:-16384}"         # context window in tokens
HERMES_PARALLEL="${HERMES_PARALLEL:-1}"   # concurrent request slots
HERMES_API_KEY="${HERMES_API_KEY:-}"      # if set, clients must send it as a Bearer token

# GPU layers to offload. "auto" = all layers if CUDA is detected, else 0 (CPU).
HERMES_NGL="${HERMES_NGL:-auto}"

# Threads for CPU inference. "auto" = physical core count.
HERMES_THREADS="${HERMES_THREADS:-auto}"

# --- Install layout ----------------------------------------------------------
HERMES_PREFIX="${HERMES_PREFIX:-/opt/hermes}"
HERMES_MODEL_DIR="${HERMES_MODEL_DIR:-$HERMES_PREFIX/models}"
HERMES_SRC_DIR="${HERMES_SRC_DIR:-$HERMES_PREFIX/src/llama.cpp}"
HERMES_BIN_DIR="${HERMES_BIN_DIR:-$HERMES_PREFIX/bin}"
HERMES_SERVICE_USER="${HERMES_SERVICE_USER:-hermes}"

# Pin llama.cpp to a known tag for reproducibility; "master" tracks upstream.
HERMES_LLAMA_REF="${HERMES_LLAMA_REF:-master}"
